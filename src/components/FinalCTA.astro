---
import { collectionMeta } from '@/data/products';
---
<section class="cta" aria-label="Enter the collection">
  <div class="cta__inner shell">
    <p class="mono muted" data-reveal>{collectionMeta.season}</p>
    <h2 class="cta__brand" data-reveal>NØR</h2>
    <a class="cta__link display" href="/#collection" data-reveal>
      ENTER THE COLLECTION <span class="cta__arrow">→</span>
    </a>
  </div>
</section>

<style>
  .cta {
    background: var(--black);
    min-height: 92svh;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: var(--section);
  }
  .cta__inner { display: flex; flex-direction: column; align-items: center; gap: 1.75rem; }
  .cta__brand {
    font-weight: 900;
    font-size: clamp(5rem, 22vw, 18rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .cta__link {
    font-size: clamp(1.1rem, 3.5vw, 2.2rem);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    letter-spacing: -0.01em;
  }
  .cta__arrow { transition: transform 0.4s var(--ease); display: inline-block; }
  .cta__link:hover .cta__arrow { transform: translateX(12px); }
</style>
