---
interface Props { index?: string; title: string; meta?: string; light?: boolean; }
const { index, title, meta, light = false } = Astro.props;
---
<div class={`sl ${light ? 'sl--light' : ''}`}>
  <span class="mono sl__l">
    {index && <span class="sl__idx">{index}</span>}
    <span>{title}</span>
  </span>
  {meta && <span class="mono muted">{meta}</span>}
</div>

<style>
  .sl {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
    gap: 1rem;
  }
  .sl--light { border-bottom-color: var(--line-dark); }
  .sl__l { display: inline-flex; gap: 0.9em; align-items: baseline; letter-spacing: 0.12em; }
  .sl__idx { color: var(--gray); }
</style>
