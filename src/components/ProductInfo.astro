---
import type { Product } from '@/data/products';
interface Props { product: Product; }
const { product } = Astro.props;
---
<div class="pinfo">
  <div class="pinfo__head">
    <span class="mono muted">{product.object}</span>
    <h1 class="display pinfo__name" data-ru={product.nameRu}>{product.name}</h1>
    <p class="mono pinfo__price" data-price={product.price}>€{product.price}</p>
  </div>

  <dl class="pinfo__opt">
    <div class="pinfo__row">
      <dt class="mono muted" data-ru="ЦВЕТ">COLOR</dt>
      <dd class="mono" data-ru={product.colorRu}>{product.color}</dd>
    </div>
    <div class="pinfo__row pinfo__row--sizes">
      <dt class="mono muted" data-ru="РАЗМЕР">SIZE</dt>
      <dd class="pinfo__sizes" role="radiogroup" aria-label="Select size">
        {product.sizes.map((s, i) => (
          <button class="pinfo__size mono" data-size role="radio"
            aria-checked={i === 2 ? 'true' : 'false'} data-active={i === 2 ? '' : undefined}>{s}</button>
        ))}
      </dd>
    </div>
  </dl>

  <button class="btn pinfo__add" data-add-bag>
    <span data-add-label data-ru="В КОРЗИНУ">ADD TO BAG</span>
    <span aria-hidden="true">→</span>
  </button>

  <div class="pinfo__section">
    <h2 class="mono muted pinfo__lbl" data-ru="ОПИСАНИЕ">DESCRIPTION</h2>
    <p class="pinfo__text" data-ru={product.descriptionRu}>{product.description}</p>
  </div>

  <div class="pinfo__section">
    <h2 class="mono muted pinfo__lbl" data-ru="ХАРАКТЕРИСТИКИ">DETAILS</h2>
    <ul class="pinfo__details mono">
      {product.details.map((d, i) => <li data-ru={product.detailsRu[i]}>{d}</li>)}
    </ul>
  </div>
</div>

<style>
  .pinfo { display: flex; flex-direction: column; gap: 2.25rem; }
  .pinfo__head { display: flex; flex-direction: column; gap: 1rem; padding-bottom: 1.75rem; border-bottom: 1px solid var(--line); }
  .pinfo__name { font-size: var(--display-3); font-weight: 700; }
  .pinfo__price { font-size: var(--step-1); letter-spacing: 0.06em; }

  .pinfo__opt { display: flex; flex-direction: column; gap: 1.5rem; margin: 0; }
  .pinfo__row { display: flex; align-items: baseline; gap: 1.5rem; }
  .pinfo__row--sizes { align-items: flex-start; }
  .pinfo__row dt { width: 64px; flex-shrink: 0; letter-spacing: 0.1em; padding-top: 0.1rem; }
  .pinfo__sizes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; }
  .pinfo__size {
    min-width: 44px;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--line);
    letter-spacing: 0.08em;
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
    color: var(--gray);
  }
  .pinfo__size:hover { border-color: var(--white); color: var(--white); }
  .pinfo__size[data-active] { border-color: var(--white); color: var(--black); background: var(--white); }

  .pinfo__add { margin-top: 0.5rem; position: relative; overflow: hidden; }
  .pinfo__add[data-added] { background: var(--white); color: var(--black); }

  .pinfo__section { display: flex; flex-direction: column; gap: 0.9rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }
  .pinfo__lbl { letter-spacing: 0.12em; }
  .pinfo__text { max-width: 46ch; color: var(--white); line-height: 1.55; }
  .pinfo__details { display: flex; flex-direction: column; gap: 0.4rem; color: var(--gray); letter-spacing: 0.08em; }
</style>

<script>
  // Local size selection (progressive, no framework needed)
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.pinfo__sizes').forEach((group) => {
      const sizes = group.querySelectorAll<HTMLButtonElement>('[data-size]');
      sizes.forEach((btn) => btn.addEventListener('click', () => {
        sizes.forEach((b) => { b.removeAttribute('data-active'); b.setAttribute('aria-checked', 'false'); });
        btn.setAttribute('data-active', ''); btn.setAttribute('aria-checked', 'true');
      }));
    });
  });
</script>
