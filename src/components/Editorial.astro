---
import Frame from './Frame.astro';
---
<section class="ed" id="editorial" aria-label="Editorial">
  <div class="ed__media" data-parallax-wrap>
    <div class="ed__reveal" data-clip>
      <Frame crop="environment" tone={1} src="/img/hero.png"
        alt="Full black AW26 look photographed against brutalist architecture"
        metaLeft="NØR / EDITORIAL" metaRight="AW26" class="ed__frame" />
    </div>
  </div>
  <div class="ed__type shell">
    <h2 class="display ed__head">
      <span class="mask"><span data-reveal data-ru="НЕ ОДЕЖДА.">NOT CLOTHES.</span></span>
      <span class="mask"><span data-reveal data-ru="УНИФОРМА.">A UNIFORM.</span></span>
    </h2>
    <p class="mono muted ed__note" data-reveal data-ru="NØR / КАМПАНИЯ — ОСЕНЬ / ЗИМА 2026">NØR / CAMPAIGN — AUTUMN / WINTER 2026</p>
  </div>
</section>

<style>
  .ed {
    position: relative;
    background: var(--black);
    padding-block: clamp(4rem, 10vw, 9rem);
    overflow: hidden;
  }
  .ed__media {
    position: relative;
    width: 100%;
    height: clamp(60vh, 78vh, 900px);
  }
  .ed__reveal {
    position: absolute;
    inset: 0;
    /* Visible by default (progressive enhancement / reduced motion);
       JS sets the clipped start state and animates it open on scroll. */
    clip-path: inset(0 0 0 0);
  }
  .ed__reveal :global(.ed__frame) { width: 100%; height: 120%; }
  .ed__reveal :global(.ed__frame img),
  .ed__reveal :global(.ed__frame .frame__gen) { height: 120%; }
  .ed__reveal :global(.ed__frame img) { object-position: 58% 42%; }
  .ed__type {
    position: absolute;
    left: 0;
    bottom: clamp(3rem, 8vw, 7rem);
    z-index: 3;
    color: var(--white);
    mix-blend-mode: difference;
  }
  .ed__head {
    font-size: var(--display-2);
    font-weight: 800;
  }
  .ed__head .mask { display: block; }
  .ed__note { margin-top: 1.5rem; }
</style>
