---
const nav = [
  { label: 'COLLECTION', ru: 'КОЛЛЕКЦИЯ', href: '/#collection' },
  { label: 'EDITORIAL', ru: 'КАМПАНИЯ', href: '/#editorial' },
  { label: 'OBJECTS', ru: 'ОБЪЕКТЫ', href: '/#lookbook' },
  { label: 'ABOUT', ru: 'О БРЕНДЕ', href: '/#about' },
];
---
<header class="hd" data-header>
  <div class="hd__bar shell">
    <a class="hd__brand" href="/" aria-label="NØR — home">NØR</a>

    <nav class="hd__nav" aria-label="Primary">
      {nav.map((n) => (
        <a class="link mono" href={n.href} data-ru={n.ru}>{n.label}</a>
      ))}
    </nav>

    <div class="hd__end">
      <button class="lang" data-lang-toggle role="switch" aria-checked="false"
        aria-label="Switch language / Сменить язык">
        <span class="lang__t lang__t--en" aria-hidden="true">EN</span>
        <span class="lang__track" aria-hidden="true"><span class="lang__knob"></span></span>
        <span class="lang__t lang__t--ru" aria-hidden="true">RU</span>
      </button>
      <button class="mono link hd__bag" data-cart-open aria-label="Open bag"><span data-ru="КОРЗИНА">BAG</span> (<span data-bag-count>0</span>)</button>
      <button class="hd__toggle mono" data-menu-open aria-label="Open menu" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile fullscreen menu -->
<div class="menu" data-menu hidden>
  <div class="menu__top shell">
    <span class="hd__brand">NØR</span>
    <button class="mono menu__close" data-menu-close aria-label="Close menu" data-ru="ЗАКРЫТЬ">CLOSE</button>
  </div>
  <nav class="menu__nav shell" aria-label="Mobile">
    {nav.map((n, i) => (
      <a class="menu__link" href={n.href} data-menu-link>
        <span class="mono menu__idx">{String(i + 1).padStart(2, '0')}</span>
        <span class="display" data-ru={n.ru}>{n.label}</span>
      </a>
    ))}
  </nav>
  <div class="menu__foot shell mono muted">
    <span>NØR / 2026</span>
    <span data-ru="ОСЕНЬ — ЗИМА">AUTUMN — WINTER</span>
  </div>
</div>

<style>
  .hd {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: transform 0.5s var(--ease), background 0.5s var(--ease),
      backdrop-filter 0.5s var(--ease), border-color 0.5s var(--ease);
    border-bottom: 1px solid transparent;
    mix-blend-mode: difference;
  }
  .hd[data-scrolled] {
    mix-blend-mode: normal;
    background: rgba(8, 8, 8, 0.55);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--line);
  }
  .hd__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 76px;
    color: var(--white);
    transition: height 0.5s var(--ease);
  }
  .hd[data-scrolled] .hd__bar { height: 60px; }

  .hd__brand {
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    justify-self: start;
  }
  .hd__nav {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    justify-self: center;
  }
  .hd__end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    justify-self: end;
  }

  /* Language slider */
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    color: currentColor;
    cursor: pointer;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    line-height: 1;
  }
  .lang__t { opacity: 0.4; transition: opacity 0.3s var(--ease); }
  :root[data-lang='en'] .lang__t--en { opacity: 1; }
  :root[data-lang='ru'] .lang__t--ru { opacity: 1; }
  .lang__track {
    position: relative;
    width: 32px;
    height: 16px;
    border: 1px solid currentColor;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .lang__knob {
    position: absolute;
    top: 50%;
    left: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: currentColor;
    transform: translateY(-50%);
    transition: left 0.3s var(--ease);
  }
  :root[data-lang='ru'] .lang__knob { left: calc(100% - 12px); }
  .lang:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .hd__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 6px 0 6px 6px;
  }
  .hd__toggle span {
    width: 24px;
    height: 1.5px;
    background: currentColor;
    display: block;
  }

  /* fullscreen menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--black);
    color: var(--white);
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s var(--ease);
  }
  .menu[data-open] { opacity: 1; pointer-events: auto; }
  .menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 76px;
  }
  .menu__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.5rem, 2vh, 1.25rem);
    border-top: 1px solid var(--line);
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.4rem 0;
    opacity: 0;
    transform: translateY(18px);
  }
  .menu[data-open] .menu__link {
    animation: menuIn 0.6s var(--ease) forwards;
  }
  .menu[data-open] .menu__link:nth-child(1) { animation-delay: 0.08s; }
  .menu[data-open] .menu__link:nth-child(2) { animation-delay: 0.14s; }
  .menu[data-open] .menu__link:nth-child(3) { animation-delay: 0.2s; }
  .menu[data-open] .menu__link:nth-child(4) { animation-delay: 0.26s; }
  @keyframes menuIn { to { opacity: 1; transform: none; } }
  .menu__idx { color: var(--gray); }
  .menu__link .display { font-size: clamp(2.4rem, 13vw, 4.5rem); }
  .menu__foot {
    display: flex;
    justify-content: space-between;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .hd__nav { display: none; }
    .hd__toggle { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu[data-open] .menu__link { animation: none; opacity: 1; transform: none; }
  }
</style>
